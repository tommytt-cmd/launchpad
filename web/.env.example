# Setup: cp .env.example .env.local, then: npm install && npm run dev
# Robinhood Chain Testnet defaults for the live launchpad deployment:
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain Testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER=https://explorer.testnet.chain.robinhood.com
NEXT_PUBLIC_FACTORY=0xb40216a118954516D7D40Ad507728d08AC51BD85
NEXT_PUBLIC_ANTISNIPE_HOOK=0xF2875076a5ad187Cb9732f04864Cb6b94aa18040
NEXT_PUBLIC_POOL_MANAGER=0x62D81f7e973486e37cdC66ad5Af7114C6e542692
NEXT_PUBLIC_V4_ROUTER=
NEXT_PUBLIC_V4_QUOTER=0x703686768a093c95737aF8F47E1D1FFdE30d778c
NEXT_PUBLIC_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Pinata file-upload credential. Keep server-side; never prefix this with NEXT_PUBLIC_.
PINATA_JWT=
# Optional dedicated Pinata gateway hostname (e.g. example.mypinata.cloud); defaults to gateway.pinata.cloud.
PINATA_GATEWAY=
# Use a free Pinata account to create an API key/JWT: https://app.pinata.cloud

# Token list needs the indexer API (see ../indexer)
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
