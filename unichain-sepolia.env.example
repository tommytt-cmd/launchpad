# Unichain Sepolia (chain 1301): official Uniswap V4 testnet. Values marked (confirm) are from memory.
# Copy the relevant lines into your shell / indexer/.env / web/.env.local.

# ---- shell, for deploy + smoke scripts ----
RPC=https://sepolia.unichain.org                    # (confirm in Unichain docs)
POOL_MANAGER=0x00b036b58a818b1bc34d502d3fe730db729e62ac
OWNER=0xYourTestnetWallet
# forge script script/Deploy.s.sol --rpc-url $RPC --account testnet --sender $OWNER --broadcast
# then: FACTORY=.. ROUTER=.. forge script script/Smoke.s.sol --rpc-url $RPC --account testnet --sender $OWNER --broadcast

# ---- indexer/.env ----
RPC_URL=https://sepolia.unichain.org
FACTORY=0x
POOL_MANAGER=0x00b036b58a818b1bc34d502d3fe730db729e62ac
START_BLOCK=                                        # block of the factory deployment
BLOCK_RANGE=2000

# ---- web/.env.local ----
NEXT_PUBLIC_CHAIN_ID=1301
NEXT_PUBLIC_CHAIN_NAME=Unichain Sepolia
NEXT_PUBLIC_RPC_URL=https://sepolia.unichain.org
NEXT_PUBLIC_EXPLORER=https://sepolia.uniscan.xyz    # (confirm in Unichain docs)
NEXT_PUBLIC_FACTORY=0x
NEXT_PUBLIC_ROUTER=0x
NEXT_PUBLIC_ANTISNIPE_HOOK=0x
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
